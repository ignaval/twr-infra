[Unit]
Description=twr relay monitoring: probe the other regions' relays
Documentation=file:///usr/local/lib/twr-relay-monitor/peer-probe.sh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/twr-relay/monitor.env
# A writable home, in case twr keeps anything there (/ is read-only below).
Environment=HOME=/var/lib/twr-relay-monitor
ExecStart=/usr/local/lib/twr-relay-monitor/peer-probe.sh
TimeoutStartSec=55
StateDirectory=twr-relay-monitor
StateDirectoryMode=0700
# Root, to read /etc/twr-relay/alert.env (0600); everything else is locked down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
