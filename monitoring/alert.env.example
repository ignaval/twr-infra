# /etc/twr-relay/alert.env on each Droplet: root:root, mode 0600. The deploy workflow writes
# it from the relay-deploy environment's ALERT_* secrets when they are set; otherwise create
# it by hand. Placeholders only: never commit real values. Plain KEY=VALUE lines; values may
# not contain quotes, backslashes or newlines. See monitoring/alert.sh.

# A push topic, for example ntfy (https://ntfy.sh/<long random topic>, or your own server).
ALERT_WEBHOOK_URL=REPLACE_ME
# ALERT_WEBHOOK_TOKEN=REPLACE_ME

# And/or mail through a relay (STARTTLS or TLS required).
# ALERT_SMTP_URL=smtps://REPLACE_ME:465
# ALERT_SMTP_USER=REPLACE_ME
# ALERT_SMTP_PASSWORD=REPLACE_ME
# ALERT_EMAIL_FROM=relay-ops@twr.tools
# ALERT_EMAIL_TO=REPLACE_ME

# ALERT_MAX_PER_HOUR=10
